# Copy to .env and adjust. Never commit .env.

# --- Postgres (owner role: runs migrations, owns the tables) ---
POSTGRES_DB=usage_rating
POSTGRES_USER=usage_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_PORT=5432

# --- Application role (subject to row-level security) ---
DB_USER=usage_app
DB_PASSWORD=change-me-app

# --- Application ---
APP_PORT=8080
LOG_LEVEL=INFO

# --- Domain tuning (optional; defaults live in application.yml) ---
# BILLING_LATE_ARRIVAL_MAX_AGE=P90D
# OUTBOX_POLL_INTERVAL=1000ms
# OUTBOX_MAX_ATTEMPTS=5
